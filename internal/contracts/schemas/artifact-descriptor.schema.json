{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soptraz.dev/schemas/artifact-descriptor.schema.json",
  "title": "SOPTRAZ Artifact Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "version", "os", "architecture", "relativePath", "sha256", "sizeBytes", "license", "sourceUri"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "artifactId": {"type": "string", "pattern": "^soptraz\\.[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 128},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$", "maxLength": 80},
    "os": {"enum": ["windows", "darwin", "linux"]},
    "architecture": {"enum": ["386", "amd64", "arm", "arm64"]},
    "relativePath": {"type": "string", "minLength": 1, "maxLength": 512},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sizeBytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
    "license": {"type": "string", "minLength": 3, "maxLength": 120},
    "sourceUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048}
  },
  "allOf": [
    {
      "if": {"properties": {"os": {"const": "windows"}}, "required": ["os"]},
      "then": {"properties": {"architecture": {"enum": ["amd64", "arm64"]}}}
    },
    {
      "if": {"properties": {"os": {"const": "darwin"}}, "required": ["os"]},
      "then": {"properties": {"architecture": {"enum": ["amd64", "arm64"]}}}
    }
  ]
}
