{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soptraz.dev/schemas/module-manifest.schema.json",
  "title": "SOPTRAZ Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "moduleId", "moduleVersion", "displayName", "description", "supportStatus", "platforms", "capabilities", "permissions", "dependencies", "license", "integrity", "createdAt"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "moduleId": {"type": "string", "pattern": "^soptraz\\.[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 120},
    "moduleVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"},
    "displayName": {"type": "string", "minLength": 2, "maxLength": 100},
    "description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "supportStatus": {"type": "string", "enum": ["experimental", "preview", "stable", "deprecated"]},
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["os", "architectures"],
        "properties": {
          "os": {"enum": ["windows", "darwin", "linux"]},
          "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["386", "amd64", "arm", "arm64"]}},
          "minimumVersion": {"type": "string", "maxLength": 80},
          "notes": {"type": "string", "maxLength": 500}
        }
      }
    },
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)+$", "maxLength": 120}},
    "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["host.read", "host.write", "network.read", "network.write", "storage.read", "storage.write", "process.execute", "system.admin", "driver.install", "firmware.write", "boot.write"]}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "versionConstraint", "optional"],
        "properties": {
          "kind": {"enum": ["module", "executable", "system_component"]},
          "id": {"type": "string", "minLength": 2, "maxLength": 160},
          "versionConstraint": {"type": "string", "minLength": 1, "maxLength": 120},
          "optional": {"type": "boolean"}
        }
      }
    },
    "license": {"type": "string", "minLength": 3, "maxLength": 120},
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": {"enum": ["ed25519", "ecdsa-p256-sha256"]},
            "keyId": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
          }
        }
      }
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "deprecatedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"supportStatus": {"const": "stable"}}, "required": ["supportStatus"]},
      "then": {"properties": {"integrity": {"required": ["signature"]}}}
    }
  ]
}
