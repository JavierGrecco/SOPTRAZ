{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soptraz.dev/schemas/process-profile.schema.json",
  "title": "SOPTRAZ Read-only Process Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "profileId", "profileVersion", "actionId", "actionVersion",
    "artifactId", "artifactVersion", "purpose", "risk", "requiresAdmin",
    "requiresApproval", "idempotent", "executionMode", "networkAccess",
    "timeoutSeconds", "fixedArguments", "outputFormat", "maxStdoutBytes",
    "maxStderrBytes", "acceptedExitCodes"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "profileId": {"type": "string", "pattern": "^soptraz\\.process\\.[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 160},
    "profileVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$", "maxLength": 80},
    "actionId": {"type": "string", "pattern": "^soptraz\\.[a-z0-9]+([.-][a-z0-9]+)*$", "maxLength": 160},
    "actionVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$", "maxLength": 80},
    "artifactId": {"type": "string", "pattern": "^[a-z][a-z0-9]*([.-][a-z0-9]+)*$", "maxLength": 128},
    "artifactVersion": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$", "maxLength": 80},
    "purpose": {"type": "string", "minLength": 10, "maxLength": 1000},
    "risk": {"const": "read_only"},
    "requiresAdmin": {"const": false},
    "requiresApproval": {"const": false},
    "idempotent": {"const": true},
    "executionMode": {"const": "direct_argv"},
    "networkAccess": {"const": "none"},
    "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "fixedArguments": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 4096}
    },
    "outputFormat": {"enum": ["none", "text", "json", "jsonl"]},
    "maxStdoutBytes": {"type": "integer", "minimum": 1, "maximum": 8388608},
    "maxStderrBytes": {"type": "integer", "minimum": 1, "maximum": 262144},
    "acceptedExitCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "contains": {"const": 0},
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    }
  }
}
